[importlinter]
root_packages =
    sagiha
    aether
# Required whenever any contract forbids an external module (domain-is-pure forbids httpx and
# sqlite3) — otherwise import-linter refuses to build a graph that could check them.
include_external_packages = True

[importlinter:contract:car-layering]
name = Agency must not reach the Runtime
type = forbidden
source_modules =
    sagiha.agency
forbidden_modules =
    sagiha.runtime
    sagiha.adapters
ignore_imports =
    sagiha.agency.* -> sagiha.ports.*
# agency/run_loop.py (Sprint 3a) is the first real code in this package, and it does import
# sagiha.ports.* — the ignore above now matches, so the contract is no longer vacuous (R6,
# 2026-07-30). Unmatched-ignore alerting is back to the tool default (error): if a future
# refactor removes agency's last ports import, that is a signal worth CI failing on, not
# a quiet no-op.

[importlinter:contract:ports-are-pure]
name = Ports import nothing internal
type = forbidden
source_modules = sagiha.ports
forbidden_modules =
    sagiha.adapters
    sagiha.runtime
    sagiha.agency
    sagiha.kernel

[importlinter:contract:domain-is-pure]
name = Domain models have no I/O dependencies
type = forbidden
source_modules = sagiha.domain
forbidden_modules =
    sagiha.adapters
    sagiha.runtime
    httpx
    sqlite3

[importlinter:contract:tcb-isolation]
name = Trusted computing base depends on nothing mutable
type = forbidden
source_modules =
    sagiha.kernel.policy
    sagiha.outer_loop.evaluator
forbidden_modules =
    sagiha.agency
    sagiha.aoi
    sagiha.adapters

[importlinter:contract:layers]
name = Overall layering
type = layers
layers =
    sagiha.agency
    sagiha.kernel
    sagiha.adapters
    sagiha.ports
    sagiha.domain

# --- AETHER v3.0 (docs/spec.md) — added alongside, not in place of, the sagiha
# contracts above: sagiha (12,949 LOC) is retiring reference material but is
# still present and still linted/tested elsewhere in CI (TASK-000). ---

[importlinter:contract:aether-domain-is-pure]
name = AETHER: domain models have no I/O dependencies (I1)
type = forbidden
source_modules = aether.domain
forbidden_modules =
    aether.adapters
    aether.kernel
    aether.measurement
    httpx
    sqlite3

[importlinter:contract:aether-ports-are-pure]
name = AETHER: ports import nothing internal (I2, I3)
type = forbidden
source_modules = aether.ports
forbidden_modules =
    aether.adapters
    aether.kernel
    aether.agency
    aether.workflow
    aether.measurement

[importlinter:contract:aether-tcb-isolation]
name = AETHER: trusted computing base depends on nothing mutable (I5, I8)
type = forbidden
source_modules =
    aether.kernel.policy
    aether.kernel.dispatch
    aether.measurement.evaluator
    aether.measurement.manifest
    aether.measurement.statistics
forbidden_modules =
    aether.agency
    aether.workflow
    aether.evolution
    aether.adapters

[importlinter:contract:aether-workflow-tcb-isolation]
name = AETHER: the workflow schema, validator and executor are TCB (spec.md §6)
type = forbidden
source_modules =
    aether.workflow.validator
    aether.workflow.executor
forbidden_modules =
    aether.agency
    aether.evolution
    aether.adapters
# A separate contract rather than two more source_modules on
# `aether-tcb-isolation`, because that contract forbids `aether.workflow` and
# these two modules legitimately import `aether.workflow.step`. `spec.md` §6
# lists "workflow schema, validator and executor" as immutable TCB and
# PHASE-0-LOCK L7 locks it; until 2026-08-07 no contract selected them, so the
# strongest claim in the lock about topology validation was enforced by nothing
# while CI stayed green — the exact trap ADR-0006 names about itself.
# `workflow/nodes/*` is deliberately NOT here: nodes import `aether.composition`
# and are mutable-surface code, not TCB.

[importlinter:contract:aether-layers]
name = AETHER: full architectural lattice (spec.md §3)
type = layers
layers =
    aether.engine
    aether.workflow
    aether.agency
    aether.measurement
    aether.kernel
    aether.adapters
    aether.ports
    aether.domain
# ADR-0018 (ratified TASK-053, ADR-0018): `aether.agency` moved from an
# independent sibling of `aether.workflow` — `(aether.agency) | aether.workflow`
# — to the layer directly beneath it. The parenthesised, piped form was
# correct only while `agency/` held no real code: import-linter treats a
# parenthesised layer as optional rather than erroring on a missing module
# (verified empirically against import-linter 2.13), which is what let this
# contract stay green with an empty package. The parentheses come off in the
# same commit that lands agency/'s first real file (`agency/capabilities/`,
# T2) — landing the package empty and the lattice edit separately would be
# the vacuous-contract trap ADR-0006 names about itself: a layer nothing has
# populated selects nothing and forbids nothing.
#
# aether.adapters came off in Sprint 2 Step 1 (TASK-026,
# adapters/trajectory_store/sqlite.py), aether.measurement came off in Step 5
# (TASK-019, measurement/evaluator.py), aether.engine came off in Step 11
# (TASK-022, engine.py). `aether.composition` is a top-level wiring root, not
# a listed layer — engine.py and workflow/* both depend on it (composition
# depends on neither), so it sits outside this lattice by design rather than
# by gap.

[importlinter:contract:aether-agency-cannot-reach-the-judge]
name = AETHER: the mutable capability layer cannot reach the TCB judge (I7, ADR-0018)
type = forbidden
source_modules =
    aether.agency
forbidden_modules =
    aether.workflow
    aether.measurement
    aether.evolution
# `aether-layers` already forbids agency -> workflow by layer order; this
# contract states it explicitly and additionally forbids agency ->
# measurement, which layer order alone PERMITS because measurement sits
# below agency in the lattice above. Without this contract, nothing stops a
# capability from importing `aether.measurement.evaluator` and constructing
# its own `RealEvaluator` — a second judge, which is the one thing I7
# forbids and the reason `capability_layer.md` §2.2 declares the `Verdict`
# capability deliberately closed. ADR-0018's own prose claimed this
# constraint before this contract existed to enforce it, which is the exact
# failure mode ADR-0006 names about itself: a document describing an
# enforcement mechanism that has not been written yet reads as safe and is
# not. `tail_biased` moving to `domain/text.py` (T1.4) is the direct
# consequence of this contract: `agency/` needs it and may not reach
# `measurement/evaluator.py` to get it.

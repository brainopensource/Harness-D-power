{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SAGIHA",
  "version": "0.1.0",
  "identifier": "dev.sagiha.gui",
  "build": {
    "beforeDevCommand": "pnpm --filter @sagiha/gui exec vite",
    "beforeBuildCommand": "pnpm --filter @sagiha/gui exec vite build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SAGIHA",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"]
  }
}

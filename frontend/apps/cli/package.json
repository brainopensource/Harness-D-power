{
  "name": "@sagiha/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "sagiha-mock": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.tsx --format esm --clean",
    "dev": "tsup src/cli.tsx --format esm --watch --onSuccess \"node dist/cli.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "pretest": "pnpm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ink": "^5.1.0",
    "react": "^18.3.0"
  },
  "devDependencies": {
    "@sagiha/config": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
